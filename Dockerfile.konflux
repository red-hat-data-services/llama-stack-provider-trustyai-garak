ARG BASE_IMAGE=quay.io/aipcc/base-images/cpu-el9.8:3.6.0-ea.2@sha256:5c280d54d233be9ebcff4ef9e39d2b1e76e8ecd84714062219eb5917dd2d1471
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
WORKDIR /opt/app-root

USER root

COPY pyproject.toml .
COPY src src

# Install the package with prefetched dependencies and test native imports.
RUN pip install --no-cache-dir ".[inline]" && \
    python -c "import pyarrow; import llama_stack_provider_trustyai_garak"

# uv is build tooling inherited from the base image, not a runtime dependency.
# Remove its bundled crypto and the uvx companion (RHOAIENG-97373).
RUN /opt/app-root/bin/python -m pip uninstall -y uv && \
    test ! -e /opt/app-root/bin/uv && \
    test ! -e /opt/app-root/bin/uvx

# Set XDG environment variables to use /tmp (always writable) for garak to write to
ENV XDG_CACHE_HOME=/tmp/.cache
ENV XDG_DATA_HOME=/tmp/.local/share
ENV XDG_CONFIG_HOME=/tmp/.config

# Allow nltk to use proxies to download words corpora for translation
ENV NLTK_ALLOW_PROXIED_URLOPEN=1

LABEL com.redhat.component="odh-trustyai-garak-lls-provider-dsp-rhel9" \
      name="rhoai/odh-trustyai-garak-lls-provider-dsp-rhel9" \
      description="TrustyAI Garak Llama Stack Provider for DSP" \
      summary="odh-trustyai-garak-lls-provider-dsp" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-trustyai-garak-lls-provider-dsp" \
      io.k8s.description="odh-trustyai-garak-lls-provider-dsp" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf" \
      com.redhat.aiplatform.image="${BASE_IMAGE}"
